#!/usr/bin/env node
'use strict';

// Usage: xa-dispatch <role> (--prompt-file <file> | --prompt <text>) [--cwd <dir>] [--timeout <sec>] [--out-dir <dir>]
//        xa-dispatch --list [--cwd <dir>]
// Prints one JSON result on stdout. Exit: 0 ok, 2 usage/config error, 3 every configured agent failed.

const fs = require('fs');
const os = require('os');
const path = require('path');
const { loadConfig } = require('../lib/config');
const { loadAdapters } = require('../lib/adapters');
const { dispatch } = require('../lib/run');

function parseArgs(argv) {
  const opts = { positional: [] };
  for (let i = 0; i < argv.length; i++) {
    const a = argv[i];
    if (a === '--list') opts.list = true;
    else if (a.startsWith('--')) opts[a.slice(2)] = argv[++i];
    else opts.positional.push(a);
  }
  return opts;
}

function fail(message) {
  process.stdout.write(`${JSON.stringify({ ok: false, exitCode: 2, error: message })}\n`);
  process.exit(2);
}

async function main() {
  const opts = parseArgs(process.argv.slice(2));
  const cwd = path.resolve(opts.cwd || process.cwd());
  const adapters = loadAdapters();

  let loaded;
  try {
    loaded = loadConfig(cwd, Object.keys(adapters));
  } catch (err) {
    return fail(err.message);
  }

  if (opts.list) {
    const roles = Object.entries(loaded.config.roles).map(([name, r]) => ({
      name, description: r.description, access: r.access, agents: r.agents,
    }));
    process.stdout.write(`${JSON.stringify({ ok: true, configDir: loaded.dir, roles }, null, 2)}\n`);
    return undefined;
  }

  const role = opts.positional[0];
  if (!role) return fail('missing <role>');
  let prompt = opts.prompt;
  if (opts['prompt-file']) prompt = fs.readFileSync(opts['prompt-file'], 'utf8');
  if (!prompt || !prompt.trim()) return fail('missing --prompt or --prompt-file');

  const outDir = opts['out-dir'] || path.join(os.tmpdir(), 'cross-agent', `${role}-${Date.now().toString(36)}`);
  const timeoutMs = Number(opts.timeout || 600) * 1000;

  try {
    const result = await dispatch({ role, prompt, cwd: loaded.dir === cwd ? cwd : cwd, config: loaded.config, adapters, outDir, timeoutMs });
    process.stdout.write(`${JSON.stringify(result, null, 2)}\n`);
    process.exit(result.exitCode);
  } catch (err) {
    return fail(err.message);
  }
  return undefined;
}

main();
